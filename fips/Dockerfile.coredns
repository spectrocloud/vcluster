ARG BUILDER_GOLANG_VERSION=1.26.5
ARG BASE_IMAGE

# FIPS 140-3 build of CoreDNS with the Go Cryptographic Module v1.0.0
# (GOFIPS140, NIST CMVP cert #4985)
FROM us-central1-docker.pkg.dev/palette-images-dev/hardened-images/builder/golang:${BUILDER_GOLANG_VERSION}-alpine AS builder

WORKDIR /workspace

ARG VERSION

RUN git -c advice.detachedHead=false clone -b v${VERSION} --depth=1 https://github.com/coredns/coredns.git

WORKDIR /workspace/coredns

RUN CGO_ENABLED=0 GOFIPS140=v1.0.0 go build -a -o /coredns .

FROM ${BASE_IMAGE:-gcr.io/distroless/static:nonroot}
# Enforce FIPS 140-3 mode at runtime
ENV GODEBUG=fips140=on
COPY --from=builder /coredns /coredns
USER 65532:65532
EXPOSE 53 53/udp

ENTRYPOINT ["/coredns"]
