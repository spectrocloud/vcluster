ARG BASE_IMAGE
ARG VERSION

# FIPS 140-3 etcd for vcluster (backingStore.etcd.deploy.enabled=true).
#
# We do NOT rebuild etcd here -- loft's etcd-fips is already a Go Cryptographic
# Module v1.0.0 build (GOFIPS140=v1.0.0, -tags=fips140v1.0, and
# DefaultGODEBUG=fips140=on compiled in). We only rebase it onto a glibc runtime.
#
# Why the rebase is required: the FIPS module build sets CGO_ENABLED=1, so the
# binary is dynamically linked (PT_INTERP=/lib64/ld-linux-x86-64.so.2,
# DT_NEEDED=libc.so.6) -- but upstream ships it on `scratch`, which has no ELF
# loader and no libc. The kernel then cannot exec it and reports the misleading
# "exec /bin/etcd: no such file or directory". This affects every published tag
# (v3.5.23 -> v3.6.10), so a tag bump does not help.
#
# Do not switch to distroless/static (as the other FIPS images here use) -- that
# has no glibc and reproduces the original failure.
FROM ghcr.io/loft-sh/etcd-fips:v${VERSION} AS src

FROM ${BASE_IMAGE:-gcr.io/distroless/base-nossl:latest}

# Redundant (upstream compiles in DefaultGODEBUG=fips140=on) but kept explicit
# to match the other FIPS 140-3 images in this repo. Use fips140=only to make
# non-approved algorithms fail instead of merely going unused.
ENV GODEBUG=fips140=on

# Must land on PATH: the vcluster chart starts etcd with command: ["etcd", ...],
# which overrides ENTRYPOINT entirely, so the binary is resolved via PATH.
COPY --from=src /bin/etcd /bin/etcdctl /usr/local/bin/

# Must run as root: the etcd data dir is a PVC mounted at /var/lib/etcd and is
# root-owned, so a :nonroot base (UID 65532) cannot write to it. The chart
# leaves podSecurityContext/containerSecurityContext empty, so nothing remaps it.
USER 0:0

EXPOSE 2379 2380 2381

ENTRYPOINT ["/usr/local/bin/etcd"]
